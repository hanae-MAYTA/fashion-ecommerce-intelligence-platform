# Copier ce fichier en `.env` puis adapter les valeurs (le fichier .env n'est pas versionné).

DB_SERVER=localhost
DB_NAME=FashionEcommerce
DB_DRIVER=ODBC Driver 17 for SQL Server

# Laisser vide pour utiliser l'authentification Windows (Trusted_Connection).
DB_USER=
DB_PASSWORD=

# Optionnel : chemin de data/processed tel que vu par SQL Server (ex. /data/processed dans Docker).
DB_BULK_DATA_DIR=
